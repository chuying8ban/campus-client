<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 自动静音 / 课前提醒所需的权限 -->
    <!-- 联网：登录教务验证、拉自己的课表、手动更新。
         少了这一条，App 里所有网络请求都会直接抛异常（界面显示"网络异常"），
         而且这个洞在纯离线测试里完全看不出来。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- 勿扰/模式访问：只声明权限是不够的。系统那份「模式访问权限」列表里**只显示
         声明了 BIND_NOTIFICATION_POLICY_ACCESS_SERVICE 服务的应用** ——
         少了下面那段 <service>，用户点「去授权」看到的列表里根本没有校园助手
         （2026-10-18 用户实测截图：模式访问权限里找不到校园助手 → 自动静音永远不生效）。 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 电池白名单：声明了它才能用 ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 直接弹
         「是否允许后台常驻」的系统窗；没声明的话那条跳转会抛异常，只能退回列表页自己找 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 应用内自动更新：没有这一条，下载完的 APK 拉不起系统安装器（会静默失败，
         用户在界面上只看到"没能拉起安装器"，很难猜到是少了权限声明）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 把「今日课表」卡片钉到桌面：国产 ROM（尤其小米）会先看这条授权。 -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.INSTALL_SHORTCUT" />

    <application
        android:name=".CampusApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="${campusLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Campus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Campus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 【勿扰（模式）访问】系统「模式访问权限」列表靠这个服务把应用列出来。
             permission + intent-filter 两个都必须有；服务本身不做事，只作为"声明存在"。
             没有它：用户进列表找不到校园助手，自动静音永远显示"缺：勿扰访问"。 -->
        <service
            android:name=".alarm.PolicyAccessService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_POLICY_ACCESS_SERVICE">
            <intent-filter>
                <action android:name="android.app.action.NOTIFICATION_POLICY_ACCESS_GRANTED_CHANGED" />
            </intent-filter>
        </service>

        <!-- 桌面小组件的「动态主题」：给 AdapterViewFlipper 供帧。
             没有它，动态主题会退化成一张静态帧（provider 里 runCatching 兜底）。 -->
        <service
            android:name=".widget.WidgetFrameService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 闹钟到点由系统唤醒，无需 App 在运行 -->
        <receiver
            android:name=".alarm.NudgeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="top.ccbase.campus.REMIND" />
                <action android:name="top.ccbase.campus.SILENCE" />
                <action android:name="top.ccbase.campus.UNSILENCE" />
            </intent-filter>
        </receiver>

        <!-- 重启后 AlarmManager 里的闹钟会被清空，必须自己重排 -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>



        <!-- 桌面「今日课表」小组件：4×2 起，系统每 30 分钟刷一次，
             课表导入成功后由 TodayWidgetProvider.refresh() 另外推一次 -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="top.ccbase.campus.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- 自动更新：把 cacheDir/update/*.apk 交给系统安装器（Android 7 起必须走 FileProvider） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
