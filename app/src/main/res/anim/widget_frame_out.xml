<?xml version="1.0" encoding="utf-8"?>
<!-- 旧帧**保持不透明**直到被新帧完全盖住（1→1）。
     这一行是全片最反直觉的地方：ViewFlipper 的默认语义是"旧的出去、新的进来"，
     两边都做 alpha 动画时中点会漏背景 → 亮度周期性下跌 = 闪烁。
     把出场动画改成"不动"，出场的 View 会在入场动画结束后被置 GONE，视觉上完全等价于交叉溶解，
     但合成亮度恒定。不要改回 1→0。 -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="110"
    android:fromAlpha="1.0"
    android:toAlpha="1.0" />
