<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课表小组件 v2（2026-10-18 重排，用户原话："太简陋了"）。

     三层：图底（渐变或预设/用户图片）→ 蒙版（只对图片主题）→ 内容。
     层次：状态（色点+小字）→ 课程名（唯一的大字）→ 时间地点 → 后几节 → 页脚。
     颜色全部由 TodayWidgetProvider.applyTheme() 按主题写，这里只给默认值。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 动态主题的帧轮播（RemoteViews 里唯一能自己动的东西就是 AdapterViewFlipper）。
         静态主题时它是 gone，底图走下面的 ImageView。 -->
    <AdapterViewFlipper
        android:id="@+id/widget_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="90"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#7A000000"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="11dp">

        <!-- ① 状态行：色点 + 状态，右侧 日期 / 周次 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:singleLine="true"
                android:textSize="11sp"
                android:textColor="#A06BFF" />

            <!-- 必须是 View：android.widget.Space 没有 @RemoteView 注解，
                 RemoteViews 充气时会被拒，桌面直接显示「载入窗口小部件时出现问题」。 -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="10.5sp"
                android:textColor="#8A84A0" />

            <TextView
                android:id="@+id/widget_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:singleLine="true"
                android:textSize="10.5sp"
                android:textColor="#8A84A0" />
        </LinearLayout>

        <!-- ② 唯一的大字：课程名 / 今天没有课 -->
        <TextView
            android:id="@+id/widget_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#F2EFFB" />

        <!-- ③ 时间 · 地点 -->
        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11.5sp"
            android:textColor="#B3ACC6" />

        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:background="#1FFFFFFF"
            android:contentDescription="@null" />

        <!-- ④ 后几节 -->
        <TextView
            android:id="@+id/widget_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11.5sp"
            android:textColor="#C8C2D8" />

        <TextView
            android:id="@+id/widget_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11.5sp"
            android:textColor="#C8C2D8" />

        <TextView
            android:id="@+id/widget_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11.5sp"
            android:textColor="#C8C2D8" />

        <ImageView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_foot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="10sp"
            android:textColor="#7E7793" />
    </LinearLayout>
</FrameLayout>
